#version 450

#include "extensions.comp"
#include "common.comp"

#define TILE_CANDIDATES 128
#define BLOCK_SUBGROUPS (TILE_CANDIDATES / SUBGROUP_SIZE)
#define BLOCK_TOPK 16

layout(local_size_x = TILE_CANDIDATES, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputPoints {
    ScoredPoint data[];
} input_points;

layout(set = 0, binding = 1) writeonly buffer OutputPoints {
    ScoredPoint data[];
} output_points;

#ifndef INPUT_HAS_HEADER
layout(set = 0, binding = 2) readonly buffer InputCount {
    uint data[];
} input_count_buffer;
#endif

shared float tile_scores[TILE_CANDIDATES];
shared uint tile_point_ids[TILE_CANDIDATES];

void subgroup_sort_ascending(inout float score, inout uint point_id) {
    uint lane = gl_SubgroupInvocationID;
    for (uint sequence = 2; sequence <= SUBGROUP_SIZE; sequence <<= 1) {
        for (uint stride = sequence >> 1; stride > 0; stride >>= 1) {
            float peer_score = subgroupShuffleXor(score, stride);
            uint peer_id = subgroupShuffleXor(point_id, stride);
            bool ascending = (lane & sequence) == 0;
            bool lower_lane = (lane & stride) == 0;
            bool take_peer = ascending == lower_lane
                ? peer_score < score
                : peer_score > score;
            if (take_peer) {
                score = peer_score;
                point_id = peer_id;
            }
        }
    }
}

void write_block_result(uint output_lane, uint point_id, float score, uint block_count) {
    ScoredPoint result;
    result.id = point_id;
    result.score = score;
    output_points.data[1 + gl_WorkGroupID.x * BLOCK_TOPK + output_lane] = result;
    if (gl_WorkGroupID.x == 0 && output_lane == 0) {
        output_points.data[0].id = block_count * BLOCK_TOPK;
        output_points.data[0].score = 0.0;
    }
}

void main() {
#ifdef INPUT_HAS_HEADER
    uint input_count = input_points.data[0].id;
    uint input_offset = 1;
#else
    uint input_count = input_count_buffer.data[0];
    uint input_offset = 0;
#endif
    uint block_count = (input_count + TILE_CANDIDATES - 1) / TILE_CANDIDATES;
    uint input_index = gl_WorkGroupID.x * TILE_CANDIDATES + gl_LocalInvocationID.x;
    ScoredPoint point;
    if (input_index < input_count) {
        point = input_points.data[input_offset + input_index];
    } else {
        point.id = INVALID_POINT_ID;
        point.score = negative_infinity;
    }

#if SUBGROUP_SIZE < 32
    uint lane = gl_LocalInvocationID.x;
    tile_scores[lane] = point.score;
    tile_point_ids[lane] = point.id;
    barrier();
    for (uint sequence = 2; sequence <= TILE_CANDIDATES; sequence <<= 1) {
        for (uint stride = sequence >> 1; stride > 0; stride >>= 1) {
            uint peer = lane ^ stride;
            if (peer > lane) {
                float own_score = tile_scores[lane];
                float peer_score = tile_scores[peer];
                bool ascending = (lane & sequence) == 0;
                bool swap_values = ascending
                    ? own_score > peer_score
                    : own_score < peer_score;
                if (swap_values) {
                    uint own_id = tile_point_ids[lane];
                    tile_scores[lane] = peer_score;
                    tile_scores[peer] = own_score;
                    tile_point_ids[lane] = tile_point_ids[peer];
                    tile_point_ids[peer] = own_id;
                }
            }
            barrier();
        }
    }
    if (lane < BLOCK_TOPK) {
        uint sorted_index = TILE_CANDIDATES - 1 - lane;
        write_block_result(
            lane,
            tile_point_ids[sorted_index],
            tile_scores[sorted_index],
            block_count
        );
    }
#else
    uint subgroup_lane = gl_SubgroupInvocationID;
    uint subgroup_in_block = gl_SubgroupID;
    float own_score = point.score;
    uint own_point_id = point.id;
    subgroup_sort_ascending(own_score, own_point_id);
    if (subgroup_lane >= SUBGROUP_SIZE - BLOCK_TOPK) {
        uint top_lane = subgroup_lane - (SUBGROUP_SIZE - BLOCK_TOPK);
        uint shared_index = subgroup_in_block * BLOCK_TOPK + top_lane;
        tile_scores[shared_index] = own_score;
        tile_point_ids[shared_index] = own_point_id;
    }
    barrier();

#if SUBGROUP_SIZE == 32
    if (subgroup_in_block < 2) {
        uint shared_index = subgroup_in_block * SUBGROUP_SIZE + subgroup_lane;
        own_score = tile_scores[shared_index];
        own_point_id = tile_point_ids[shared_index];
        subgroup_sort_ascending(own_score, own_point_id);
        if (subgroup_lane >= SUBGROUP_SIZE - BLOCK_TOPK) {
            uint top_lane = subgroup_lane - (SUBGROUP_SIZE - BLOCK_TOPK);
            uint merged_index = subgroup_in_block * BLOCK_TOPK + top_lane;
            tile_scores[merged_index] = own_score;
            tile_point_ids[merged_index] = own_point_id;
        }
    }
    barrier();
    if (subgroup_in_block == 0) {
        own_score = tile_scores[subgroup_lane];
        own_point_id = tile_point_ids[subgroup_lane];
        subgroup_sort_ascending(own_score, own_point_id);
        if (subgroup_lane >= SUBGROUP_SIZE - BLOCK_TOPK) {
            uint output_lane = SUBGROUP_SIZE - 1 - subgroup_lane;
            write_block_result(output_lane, own_point_id, own_score, block_count);
        }
    }
#else
    if (subgroup_in_block == 0) {
        uint intermediate_count = BLOCK_SUBGROUPS * BLOCK_TOPK;
        own_score = subgroup_lane < intermediate_count
            ? tile_scores[subgroup_lane]
            : negative_infinity;
        own_point_id = subgroup_lane < intermediate_count
            ? tile_point_ids[subgroup_lane]
            : INVALID_POINT_ID;
        subgroup_sort_ascending(own_score, own_point_id);
        if (subgroup_lane >= SUBGROUP_SIZE - BLOCK_TOPK) {
            uint output_lane = SUBGROUP_SIZE - 1 - subgroup_lane;
            write_block_result(output_lane, own_point_id, own_score, block_count);
        }
    }
#endif
#endif
}
