#version 450

#include "extensions.comp"
#include "common.comp"

#define TILE_CANDIDATES 128
#define BLOCK_SUBGROUPS (TILE_CANDIDATES / SUBGROUP_SIZE)
#define CANDIDATES_PER_SUBGROUP SUBGROUP_SIZE
#define BLOCK_TOPK 16

layout(local_size_x = TILE_CANDIDATES, local_size_y = 1, local_size_z = 1) in;

#define VECTOR_STORAGE_LAYOUT_SET 1
#include "vector_storage.comp"

layout(set = 0, binding = 0) readonly buffer CandidateIds {
    uint data[];
} candidate_ids;

layout(set = 0, binding = 1) readonly buffer QueryVector {
    vec4 data[];
} query_vector;

layout(set = 0, binding = 2) writeonly buffer BlockResults {
    ScoredPoint data[];
} block_results;

shared float tile_scores[TILE_CANDIDATES];
shared uint tile_candidate_indices[TILE_CANDIDATES];

void load_query_target() {
#ifdef SINGLE_SUBGROUP_PER_VECTOR
    target_cache = query_vector.data[gl_SubgroupInvocationID];
#else
    for (uint i = 0; i < SUBGROUPS_COUNT_PER_VECTOR; i++) {
        target_cache[i] = query_vector.data[i * SUBGROUP_SIZE + gl_SubgroupInvocationID];
    }
#endif
}

void main() {
    uint subgroup_in_block = gl_SubgroupID;
    uint candidate_count = candidate_ids.data.length();
    uint block_start = gl_WorkGroupID.x * TILE_CANDIDATES;

    load_query_target();
    for (uint iteration = 0; iteration < CANDIDATES_PER_SUBGROUP; iteration++) {
        uint tile_index = iteration * BLOCK_SUBGROUPS + subgroup_in_block;
        uint candidate_index = block_start + tile_index;
        float score = negative_infinity;
        if (candidate_index < candidate_count) {
            score = similarity(candidate_ids.data[candidate_index]);
        }
        if (subgroupElect()) {
            tile_scores[tile_index] = score;
            tile_candidate_indices[tile_index] = candidate_index < candidate_count
                ? candidate_index
                : INVALID_POINT_ID;
        }
    }
    barrier();

    // Sort the 128 candidate scores in ascending order. Unlike the rejected
    // lane-0 insertion experiment, every invocation owns one compare/exchange
    // lane and all candidate distance calculations remain subgroup-parallel.
    uint lane = gl_LocalInvocationID.x;
    for (uint sequence = 2; sequence <= TILE_CANDIDATES; sequence <<= 1) {
        for (uint stride = sequence >> 1; stride > 0; stride >>= 1) {
            uint peer = lane ^ stride;
            if (peer > lane) {
                float own_score = tile_scores[lane];
                float peer_score = tile_scores[peer];
                bool ascending = (lane & sequence) == 0;
                bool swap_values = ascending
                    ? own_score > peer_score
                    : own_score < peer_score;
                if (swap_values) {
                    uint own_index = tile_candidate_indices[lane];
                    tile_scores[lane] = peer_score;
                    tile_scores[peer] = own_score;
                    tile_candidate_indices[lane] = tile_candidate_indices[peer];
                    tile_candidate_indices[peer] = own_index;
                }
            }
            barrier();
        }
    }

    if (lane < BLOCK_TOPK) {
        uint sorted_index = TILE_CANDIDATES - 1 - lane;
        uint candidate_index = tile_candidate_indices[sorted_index];
        ScoredPoint result;
        result.id = candidate_index == INVALID_POINT_ID
            ? INVALID_POINT_ID
            : candidate_ids.data[candidate_index];
        result.score = tile_scores[sorted_index];
        block_results.data[gl_WorkGroupID.x * BLOCK_TOPK + lane] = result;
    }
}
